{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NHILensReadOnlyAudit",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "iam:GetAccountAuthorizationDetails",
        "iam:GetLoginProfile",
        "iam:ListAccessKeys",
        "iam:GetAccessKeyLastUsed",
        "iam:GenerateServiceLastAccessedDetails",
        "iam:GetServiceLastAccessedDetails",
        "cloudtrail:LookupEvents"
      ],
      "Resource": "*"
    }
  ]
}
